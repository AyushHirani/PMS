<%- include('partials/header') %>
<%- include('partials/nav-property') %>

<script>
        const params = new URLSearchParams(window.location.search);
        const success = params.get("success");

        if (success) {
            alert(success);
        }
</script>

<div id="box">
    <% if (requests.length === 0) { %>
        <p>There are no maintenance requests for your properties yet.</p>
    <% } else { %>

        <% requests.forEach(request => { %>
            <div class="request-card mb-3">
                <div class="card-body">
                        <h5><%= request.issue %></h5>

                        <p>
                                <strong>Tenant:</strong>
                                <%= request.tenantName || "Unknown tenant" %>
                        </p>

                        <p>
                                <strong>Tenant Email:</strong>
                                <%= request.tenantEmail || "Not available" %>
                        </p>

                        <p>
                                <strong>Description:</strong>
                                <%= request.description %>
                        </p>

                        <p>
                                <strong>Urgency:</strong>
                                <%= request.urgency %>
                        </p>

                        <p>
                                <strong>Status:</strong>
                                <%= request.status %>
                        </p>

                        <p>
                                <strong>Submitted On:</strong>
                                <%= new Date(request.createdAt).toLocaleDateString() %>
                        </p>

                        <% if (request.assignedTo) { %>
                                <p>
                                <strong>Assigned To:</strong>
                                <%= request.assignedTo %>
                                </p>
                        <% } %>

                        <% if (request.status === "Pending") { %>
                        <div class="card-btns">
                                                        <details class="request-edit">
                                <summary class="btn btn2 btn-warning">Edit Urgency</summary>
                                <form action="/edit-request" method="POST" class="mt-2">
                                    <input type="hidden" name="requestId" value="<%= request._id %>">
                                    <label for="urgency-<%= request._id %>">Urgency</label>
                                    <select
                                        class="form-select mb-2"
                                        id="urgency-<%= request._id %>"
                                        name="urgency"
                                        required
                                    >
                                        <% ["Low", "Medium", "High", "Emergency"].forEach(urgency => { %>
                                            <option value="<%= urgency %>" <%= request.urgency === urgency ? "selected" : "" %>>
                                                <%= urgency %>
                                            </option>
                                        <% }); %>
                                    </select>
                                    <button type="submit" class="btn btn-dark">Save Urgency</button>
                                </form>
                            </details>
                            <details class="request-inquiry">
                                <summary class="btn btn2 btn-primary">Inquire</summary>
                                <form action="/inquire-request" method="POST">
                                    <input type="hidden" name="requestId" value="<%= request._id %>">
                                    <label for="inquiry-<%= request._id %>">Message to tenant</label>
                                    <textarea
                                        class="form-control"
                                        name="message"
                                        id="inquiry-<%= request._id %>"
                                        rows="3"
                                        maxlength="2000"
                                        required
                                    ></textarea>
                                    <button type="submit" class="btn btn-dark mt-2">
                                        Email Inquiry
                                    </button>
                                </form>
                            </details>
                            <form action="/assign-request" method="POST">
                                <input type="hidden" name="requestId" value="<%= request._id %>">
                                <button type="submit" class="btn btn2 btn-success">Assign</button>
                            </form>
                            <form action="/reject-request" method="POST">
                                <input type="hidden" name="requestId" value="<%= request._id %>">
                                <button type="submit" class="btn btn2 btn-danger">Reject</button>
                            </form>
                        </div>
                        <% } %>
                </div>
            </div>
        <% }); %>

    <% } %>
</div>

<%- include('partials/footer') %>
