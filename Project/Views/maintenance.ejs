<%- include('partials/header') %>
<%- include('partials/nav-display') %>

<div id="box">
    <% if (queue.length === 0) { %>
        <p>You don't have any assigned requests yet.</p>
    <% } else { %>

        <% queue.forEach(({ request, property }) => { %>
            <div class="request-card mb-3">
                <div class="card-body">
                        <h5><%= request.issue %></h5>

                        <p>
                                <strong>Description:</strong>
                                <%= request.description %>
                        </p>

                        <p>
                                <strong>Urgency:</strong>
                                <%= request.urgency %>
                        </p>

                        <p>
                                <strong>Status:</strong>
                                <%= request.status %>
                        </p>

                        <p>
                                <strong>Tenant Name:</strong>
                                <%= request.tenantName %>
                        </p>

                        <p>
                                <strong>Tenant Email:</strong>
                                <%= request.tenantEmail %>
                        </p>

                        <p>
                                <strong>Property Address:</strong>
                                <% if (property) { %>
                                    <%= [property.streetAddress, property.city, property.province, property.pin]
                                        .filter(Boolean)
                                        .join(", ") %>
                                <% } else { %>
                                    Not available
                                <% } %>
                        </p>

                        <p>
                                <strong>Owner Name:</strong>
                                <%= property?.ownerId?.userName || "Not available" %>
                        </p>

                        <p>
                                <strong>Owner Email:</strong>
                                <%= property?.ownerId?.email || "Not available" %>
                        </p>

                        <p>
                                <strong>Submitted On:</strong>
                                <%= new Date(request.createdAt).toLocaleDateString() %>
                        </p>

                        <% if (request.status === "Assigned" || request.status === "In Progress") { %>
                            <details>
                                <summary class="btn btn-dark">Edit Progress</summary>
                                <form
                                    method="POST"
                                    action="/maintenance/requests/<%= request._id %>/progress"
                                    class="mt-3"
                                >
                                    <label for="status-<%= request._id %>">Progress</label>
                                    <select
                                        class="form-select mb-2"
                                        id="status-<%= request._id %>"
                                        name="status"
                                        required
                                    >
                                        <option value="In Progress" <%= request.status === "In Progress" ? "selected" : "" %>>
                                            In Progress
                                        </option>
                                        <option value="Resolved">Resolved</option>
                                    </select>
                                    <button type="submit" class="btn btn-primary">
                                        Save Progress
                                    </button>
                                </form>
                            </details>
                        <% } %>
                </div>
            </div>
        <% }); %>

    <% } %>
</div>

<%- include('partials/footer') %>
